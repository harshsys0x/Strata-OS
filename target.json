{
  "llvm-target": "i686-unknown-none",
  "data-layout": "e-m:e-p:32:32-p270:32:32-p271:32:32-p272:64:64-i128:128-f64:32:64-f80:32-n8:16:32-S128",
  "arch": "x86",
  "target-endian": "little",
  "target-pointer-width": 32,
  "target-c-int-width": 32,
  "os": "none",
  "executables": true,
  "linker-flavor": "gcc",
  "linker": "/home/harsh/bin/i686-elf-gcc-wsl",
  "panic-strategy": "abort",
  "disable-redzone": true,
  "features": "+soft-float,-sse",
  "rustc-abi": "softfloat",
  "pre-link-args": {
    "gcc": [
      "-BD:/osdev/opt/cross/libexec/gcc/i686-elf/16.2.0/",
      "-BD:/osdev/opt/cross/bin/",
      "-Wl,--script=D:/Strata-OS/linker.ld",
      "-ffreestanding",
      "-O2",
      "-nostdlib",
      "-nostartfiles"
    ]
  }
}
